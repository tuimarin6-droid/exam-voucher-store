/* --- Hero motion graphic (graduation / 8 A1s celebration) --- */
.hero-decor {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
.hero-glow {
  position: absolute;
  border-radius: 9999px;
  filter: blur(64px);
}
.hero-glow-1 {
  width: 340px; height: 340px;
  background: #8eb6ff; opacity: .45;
  top: -90px; left: -60px;
  animation: heroDrift 15s ease-in-out infinite;
