  --card:0 1px 3px rgba(15,23,42,.06),0 8px 24px rgba(15,23,42,.06);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink900);line-height:1.5}
h1,h2,h3{font-family:'Trebuchet MS',Verdana,sans-serif;letter-spacing:-.02em}
a{text-decoration:none;color:inherit}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
.svg{width:20px;height:20px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round;flex:none}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:12px;padding:12px 20px;font-size:14px;font-weight:600;min-height:44px;cursor:pointer;transition:all .2s;border:0}
.btn-primary{background:var(--brand600);color:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05),0 4px 12px rgba(0,0,0,.04)}
.btn-primary:hover{background:var(--brand700)}
.btn-accent{background:var(--acc);color:#fff}
.btn-accent:hover{background:var(--acc700)}
.btn-ghost{background:#fff;color:var(--ink900);border:1px solid var(--border)}
.btn-ghost:hover{background:var(--soft)}
.card{border-radius:12px;border:1px solid var(--border);background:#fff;box-shadow:var(--card)}
.chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;background:var(--brand50);padding:5px 12px;font-size:12px;font-weight:600;color:var(--brand700)}
.secure{display:inline-flex;align-items:center;gap:6px;border-radius:999px;background:var(--accSoft);padding:5px 12px;font-size:12px;font-weight:600;color:var(--acc700)}
.muted{color:var(--ink500)}
.small{font-size:14px}

/* nav */
header{position:sticky;top:0;z-index:40;border-bottom:1px solid var(--border);background:rgba(255,255,255,.92);backdrop-filter:blur(8px)}
.nav{display:flex;align-items:center;justify-content:space-between;padding:14px 20px}
.logo{display:flex;align-items:center;gap:10px}
.logo .badge{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:var(--brand600);color:#fff}
.logo .name{font-family:'Trebuchet MS',sans-serif;font-size:18px;font-weight:800}
.logo .name b{color:var(--brand600)}
.nav .links{display:flex;align-items:center;gap:16px}
.nav .links a{font-size:14px;font-weight:600;color:var(--ink700)}
.nav .links a:hover{color:var(--brand600)}

/* hero */
.hero{background:linear-gradient(to bottom,var(--brand50),var(--bg));padding:72px 0}
.hero .inner{max-width:640px;margin:0 auto;text-align:center}
.hero h1{font-size:48px;font-weight:800;line-height:1.1;margin-top:20px}
.hero h1 span{color:var(--brand600)}
.hero p{margin:16px auto 0;max-width:520px;color:var(--ink700)}
.hero .cta{margin-top:28px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.stars{display:inline-flex;color:var(--acc)}
.rating{margin-top:24px;display:flex;align-items:center;justify-content:center;gap:6px;font-size:14px;color:var(--ink500)}

/* trust strip */
.strip{margin-top:-24px}
.grid3{display:grid;gap:16px;grid-template-columns:repeat(3,1fr)}
.tcard{display:flex;gap:12px;align-items:flex-start;padding:20px}
.tcard .ic{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--brand50);color:var(--brand600);flex:none}
.tcard p.t{font-weight:600}
.tcard p.d{margin-top:2px;font-size:14px;color:var(--ink500)}

/* section */
section.pad{padding:64px 0}
.section-head{max-width:560px;margin-bottom:32px}
.section-head h2{font-size:30px;font-weight:800}
.section-head p{margin-top:8px;color:var(--ink500)}

/* products */
.grid4{display:grid;gap:24px;grid-template-columns:repeat(4,1fr)}
.pcard{display:flex;flex-direction:column;padding:24px}
.pcard .top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.pcard .ic{display:grid;place-items:center;width:44px;height:44px;border-radius:12px;background:var(--brand50);color:var(--brand600)}
.pcard .ic.form{background:var(--accSoft);color:var(--acc700)}
.pcard h3{margin-top:16px;font-size:18px;font-weight:700}
.pcard .desc{margin-top:6px;font-size:14px;color:var(--ink500)}
.pcard ul{list-style:none;margin-top:16px;display:flex;flex-direction:column;gap:8px}
.pcard li{display:flex;align-items:center;gap:8px;font-size:14px;color:var(--ink700)}
.pcard li .tick{display:grid;place-items:center;width:20px;height:20px;border-radius:999px;background:var(--accSoft);color:var(--acc700);flex:none}
.pcard .foot{margin-top:24px;display:flex;align-items:flex-end;justify-content:space-between;border-top:1px solid var(--soft);padding-top:20px}
.pcard .price{font-family:'Trebuchet MS',sans-serif;font-size:24px;font-weight:800}
.pcard .price small{font-size:12px;font-weight:400;color:var(--ink500);margin-left:4px}

/* checkout */
