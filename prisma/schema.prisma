// Prisma schema for the exam voucher store.
// PostgreSQL production database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single sellable voucher code that you upload in bulk.
model Voucher {
  id          String        @id @default(cuid())
  productType String
  code        String        @unique
  status      VoucherStatus @default(AVAILABLE)
  soldTo      String?
  reference   String?
  soldAt      DateTime?
  createdAt   DateTime      @default(now())

  orderVouchers OrderVoucher[]

  @@index([productType, status])
  @@index([reference])
  @@index([soldTo])
}

enum VoucherStatus {
  AVAILABLE
  RESERVED
  SOLD
}

/// One purchase attempt, keyed by the Paystack reference.
model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  email          String
  phone          String?
  productType    String
  category       String
  amount         Int
  originalAmount Int?
  discountAmount Int         @default(0)
  currency       String      @default("GHS")
  status         OrderStatus @default(PENDING)
  quantity       Int         @default(1)
  promoCode      String?
  voucherCode    String?
  emailSent      Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orderVouchers  OrderVoucher[]

  promo          PromoCode?  @relation(fields: [promoCode], references: [code])

  @@index([status])
  @@index([email])
  @@index([email, createdAt])
  @@index([promoCode])
}

/// Connects an Order to one or more Voucher records.
model OrderVoucher {
  id        String   @id @default(cuid())
  orderId   String
  voucherId String
  createdAt DateTime @default(now())

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  voucher   Voucher @relation(fields: [voucherId], references: [id])

  @@unique([orderId, voucherId])
  @@index([orderId])
  @@index([voucherId])
}

/// Promotional/discount codes.
model PromoCode {
  id                     String   @id @default(cuid())
  code                   String   @unique

  /// Discounted price per voucher in pesewas.
  /// GHS 20 = 2000.
  discountedPrice        Int      @default(2000)

  /// Maximum number of discounted vouchers one customer
  /// can purchase using this promo.
  maxVouchersPerCustomer Int      @default(2)

  /// Maximum number of successful redemptions overall.
  /// Null means unlimited.
  maxRedemptions         Int?

  /// Number of successful redemptions so far.
  redemptionCount        Int      @default(0)

  /// Whether the promo is currently active.
  active                 Boolean  @default(true)

  /// If true, the customer must have at least
  /// 5 completed qualifying purchases.
  requiresFivePurchases  Boolean  @default(false)

  /// Optional expiry date.
  expiresAt              DateTime?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  allowedEmails          PromoEmail[]
  redemptions            PromoRedemption[]
  orders                 Order[]

  @@index([active])
  @@index([expiresAt])
}

/// Allows a promo code to be restricted to specific email addresses.
model PromoEmail {
  id          String   @id @default(cuid())
  promoCodeId String
  email       String
  createdAt   DateTime @default(now())

  promo       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, email])
  @@index([email])
}

/// Records successful uses of promo codes.
model PromoRedemption {
  id             String   @id @default(cuid())
  promoCodeId    String
  email          String
  orderReference String
  quantity       Int
  discountAmount Int
  createdAt      DateTime @default(now())

  promo          PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, orderReference])
  @@index([email])
  @@index([promoCodeId])
  @@index([email, promoCodeId])
}

/// Tracks stock-alert notifications.
model StockAlert {
  id            String   @id @default(cuid())
  productType   String
  stockLevel    Int
  emailSent     Boolean  @default(false)
  whatsappSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productType])
  @@index([productType, createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  OUT_OF_STOCK
}
