// Prisma schema for the exam voucher store.
// Default: SQLite (zero-config). For production, switch provider to
// "postgresql" or "mysql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A single sellable voucher code that you upload in bulk.
model Voucher {
  id          String        @id @default(cuid())
  productType String        // "WASSCE" | "WASSCE_PRIVATE" | "BECE"
  code        String        @unique
  status      VoucherStatus @default(AVAILABLE)
  soldTo      String?       // buyer email once dispensed
  reference   String?       // Paystack reference that claimed this code
  soldAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([productType, status])
  @@index([reference])
}

enum VoucherStatus {
  AVAILABLE
  RESERVED
  SOLD
}

/// One purchase attempt, keyed by the Paystack reference (idempotency anchor).
model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  email          String
  phone          String?
  productType    String      // product id (see src/lib/products.ts)
  category       String      // "VOUCHER" | "FORM"
  amount         Int         // FINAL amount charged via Paystack (minor units) = originalAmount - discountAmount + processingFee
  currency       String      @default("GHS")
  status         OrderStatus @default(PENDING)
  voucherCode    String?     // filled for fulfilled voucher orders
  emailSent      Boolean     @default(false)

  // --- Promo / pricing breakdown (all minor units) ---
  originalAmount   Int?        // catalog price before discount/fee, for the receipt/admin view
  discountAmount   Int         @default(0)
  processingFee    Int         @default(0)
  promoCode        String?     // the code as entered (uppercased), null if none applied
  promoCodeId      String?     // PromoCode.id this order used, for joins/reporting

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  redemption     PromoRedemption?

  @@index([status])
  @@index([promoCodeId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  OUT_OF_STOCK
}

enum PromoDiscountType {
  PERCENT // discountValue is 1-100
  FIXED   // discountValue is minor units (pesewas) off
}

/// What a promo code is allowed to discount.
enum PromoScope {
  ALL     // any product
  VOUCHER // any VOUCHER-category product (WASSCE/BECE etc.)
  FORM    // any FORM-category product
  PRODUCT // exactly one product, see scopeProductId
}

/// A discount code that can be applied at checkout. Single-use codes are
/// modeled as maxUses = 1; shared/bulk codes use a higher maxUses or null
/// (unlimited). usedCount is only ever incremented AFTER a successful
/// payment (see PromoRedemption + src/lib/fulfilment.ts), never at checkout
/// entry, so an abandoned checkout never burns a use.
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // always stored/matched uppercase
  description    String?

  discountType   PromoDiscountType
  discountValue  Int               // percent (1-100) for PERCENT, minor units for FIXED

  scope          PromoScope        @default(ALL)
  scopeProductId String?           // required when scope = PRODUCT (see src/lib/products.ts ids)

  maxUses        Int?              // null = unlimited total redemptions
  usedCount      Int               @default(0)
  minSubtotal    Int?              // optional minimum order amount (minor units) to qualify

  active         Boolean           @default(true)
  startsAt       DateTime?         // optional — code not valid before this
  expiresAt      DateTime?         // optional — code not valid on/after this

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  redemptions    PromoRedemption[]

  @@index([active])
}

/// One promo code applied to one order. Unique on orderReference so the
/// consuming logic in fulfilByReference() can never double-count a redemption
/// even if the webhook, redirect-verify, and admin retry all fire for the
/// same order.
model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id])
  orderReference String    @unique
  order          Order     @relation(fields: [orderReference], references: [reference])
  discountAmount Int       // minor units actually discounted on this order
  createdAt      DateTime  @default(now())

  @@index([promoCodeId])
}
