import { NextResponse } from "next/server";
import { z } from "zod";
import { prisma } from "@/lib/db";
import { getProduct } from "@/lib/products";
import { initializeTransaction, newReference } from "@/lib/paystack";
import { countAvailable } from "@/lib/inventory";
import { validatePromoCode } from "@/lib/promos";

export const dynamic = "force-dynamic";

const bodySchema = z.object({
  productId: z.string(),
  email: z.string().email(),
  phone: z.string().min(6).optional(),
  quantity: z.coerce.number().int().min(1).max(9).default(1),
  promoCode: z.string().optional(),
});

export async function POST(req: Request) {
  try {
    let parsed;
    try {
      parsed = bodySchema.parse(await req.json());
    } catch {
      return NextResponse.json(
        { error: "Invalid request body" },
        { status: 400 }
      );
    }

    const product = getProduct(parsed.productId);
    if (!product) {
      return NextResponse.json(
        { error: "Unknown product" },
        { status: 404 }
      );
    }

    if (product.category === "FORM" && parsed.quantity !== 1) {
      return NextResponse.json(
        { error: "University admission forms can only be purchased one at a time." },
        { status: 400 }
      );
    }

    if (product.category === "VOUCHER") {
      const available = await countAvailable(product.voucherType!);
      if (available < parsed.quantity) {
        return NextResponse.json(
          {
            error:
              available === 0
                ? "This voucher is currently out of stock."
                : `Only ${available} voucher${
                    available === 1 ? "" : "s"
                  } available.`,
          },
          { status: 409 }
        );
      }
    }

    const originalAmount = product.amount * parsed.quantity;
    let amount = originalAmount;
    let discountAmount = 0;
    let validatedPromoCode: string | null = null;

    if (parsed.promoCode && parsed.promoCode.trim()) {
      if (product.category !== "VOUCHER") {
        return NextResponse.json(
          { error: "Promo codes only apply to voucher products." },
          { status: 400 }
        );
      }

      const promoResult = await validatePromoCode({
        code: parsed.promoCode.trim(),
        email: parsed.email,
        quantity: parsed.quantity,
        regularUnitPrice: product.amount,
      });

      if (!promoResult.valid) {
        return NextResponse.json(
          { error: promoResult.reason || "Invalid promo code" },
          { status: 400 }
        );
      }

      amount = promoResult.totalAmount!;
      discountAmount = promoResult.discountAmount!;
      validatedPromoCode = promoResult.promoCode || null;
    }

    const reference = newReference();
    const siteUrl = process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000";
    const callbackUrl = `${siteUrl}/success?reference=${encodeURIComponent(reference)}`;

    // Create pending order with null-safe promo relation
    await prisma.order.create({
      data: {
        reference,
        email: parsed.email,
        phone: parsed.phone || null,
        productType: product.id,
        category: product.category,
        amount,
        originalAmount,
        discountAmount,
        currency: product.currency,
        status: "PENDING",
        quantity: parsed.quantity,
        promoCode: validatedPromoCode,
      },
    });

    try {
      const init = await initializeTransaction({
        email: parsed.email,
        amount,
        currency: product.currency,
        reference,
        callbackUrl,
        metadata: {
          productId: product.id,
          category: product.category,
          quantity: parsed.quantity,
          promoCode: validatedPromoCode ?? undefined,
        },
      });

      return NextResponse.json({
        authorizationUrl: init.authorization_url,
        reference,
      });
    } catch (err) {
      console.error("[initialize] paystack error:", err);
      await prisma.order.update({
        where: { reference },
        data: { status: "FAILED" },
      });
      return NextResponse.json(
        { error: "Could not start payment. Try again." },
        { status: 502 }
      );
    }
  } catch (error: any) {
    console.error("[initialize] route crash:", error);
    return NextResponse.json(
      { error: error?.message || "Internal server error" },
      { status: 500 }
    );
  }
}
