// ---------------------------------------------------------------------------
// PRODUCTION SCHEMA (PostgreSQL)
//
// To switch from SQLite to Postgres:
//   1) Replace prisma/schema.prisma with this file's contents
//      (or copy this over it).
//   2) Set DATABASE_URL in .env to your Postgres connection string, e.g.
//      DATABASE_URL="postgresql://user:pass@host:5432/edupass?schema=public"
//   3) Run:  npx prisma migrate dev --name init
//
// Everything else in the app is identical — the atomic dispensing logic,
// idempotency, and webhook flow all work the same on Postgres.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Voucher {
  id          String        @id @default(cuid())
  productType String
  code        String        @unique
  status      VoucherStatus @default(AVAILABLE)
  soldTo      String?
  reference   String?
  soldAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([productType, status])
  @@index([reference])
}

enum VoucherStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  email          String
  phone          String?
  productType    String
  category       String
  amount         Int         // FINAL amount charged via Paystack = originalAmount - discountAmount + processingFee
  currency       String      @default("GHS")
  status         OrderStatus @default(PENDING)
  voucherCode    String?
  emailSent      Boolean     @default(false)

  originalAmount   Int?
  discountAmount   Int         @default(0)
  processingFee    Int         @default(0)
  promoCode        String?
  promoCodeId      String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  redemption     PromoRedemption?

  @@index([status])
  @@index([promoCodeId])
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  FAILED
  OUT_OF_STOCK
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

enum PromoScope {
  ALL
  VOUCHER
  FORM
  PRODUCT
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String?

  discountType   PromoDiscountType
  discountValue  Int

  scope          PromoScope        @default(ALL)
  scopeProductId String?

  maxUses        Int?
  usedCount      Int               @default(0)
  minSubtotal    Int?

  active         Boolean           @default(true)
  startsAt       DateTime?
  expiresAt      DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  redemptions    PromoRedemption[]

  @@index([active])
}

model PromoRedemption {
  id             String    @id @default(cuid())
  promoCodeId    String
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id])
  orderReference String    @unique
  order          Order     @relation(fields: [orderReference], references: [reference])
  discountAmount Int
  createdAt      DateTime  @default(now())

  @@index([promoCodeId])
}
